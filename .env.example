# Copy to .env for local overrides (.env is git-ignored, never commit it).
# On a server, set these as environment variables in the host's dashboard instead.

# 1 = development (debug pages, http). 0 = production (HTTPS-only, secure cookies).
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated host names the site is served on, e.g. matatu-fleet-log.onrender.com
DJANGO_ALLOWED_HOSTS=

# Optional: comma-separated https origins allowed to POST forms. Defaults to https://<each allowed host>.
DJANGO_CSRF_TRUSTED_ORIGINS=
